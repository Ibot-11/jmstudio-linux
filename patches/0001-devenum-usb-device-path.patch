+/* Applications identify USB cameras by the DevicePath that Windows reports,
+ *   \\?\usb#vid_xxxx&pid_xxxx[&mi_xx]#<instance>#{65e8773d-8f56-11d0-a3b9-00a0c9223196}\global
+ * which carries the vendor and product ID. A v4l2 node has none of that, so read it from the
+ * USB interface that provides /dev/videoN: its sysfs "modalias" holds the IDs and the device
+ * class, e.g. "usb:v0BCDp000Ad0009dcEFdsc02dp01ic0Eisc01ip00in00". */
+#define SYSFS_VIDEO4LINUX L"Z:\\sys\\class\\video4linux"
+
+static BOOL read_sysfs_attr(const WCHAR *dir, const WCHAR *name, char *buf, DWORD size)
+{
+    WCHAR path[MAX_PATH];
+    DWORD len = 0;
+    HANDLE file;
+
+    swprintf(path, ARRAY_SIZE(path), L"%ls\\%ls", dir, name);
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    if (!ReadFile(file, buf, size - 1, &len, NULL)) len = 0;
+    CloseHandle(file);
+
+    while (len && (buf[len - 1] == '\n' || buf[len - 1] == ' ')) len--;
+    buf[len] = 0;
+    return len != 0;
+}
+
+static BOOL get_usb_device_path(unsigned int index, WCHAR *device_path, size_t len)
+{
+    char modalias[96], iface[8], vid[5], pid[5];
+    WCHAR dir[MAX_PATH];
+    UINT32 hash = 2166136261u;
+    BOOL composite;
+    unsigned int i;
+
+    swprintf(dir, ARRAY_SIZE(dir), SYSFS_VIDEO4LINUX L"\\video%u\\device", index);
+    if (!read_sysfs_attr(dir, L"modalias", modalias, sizeof(modalias))
+            || !read_sysfs_attr(dir, L"bInterfaceNumber", iface, sizeof(iface)))
+        return FALSE;
+
+    for (i = 0; modalias[i]; i++) modalias[i] = tolower(modalias[i]);
+    if (strlen(modalias) < 32 || memcmp(modalias, "usb:v", 5) || modalias[9] != 'p' || modalias[14] != 'd'
+            || memcmp(modalias + 19, "dc", 2) || memcmp(modalias + 23, "dsc", 3) || memcmp(modalias + 28, "dp", 2))
+        return FALSE;
+    memcpy(vid, modalias + 5, 4); vid[4] = 0;
+    memcpy(pid, modalias + 10, 4); pid[4] = 0;
+
+    /* Windows puts a device with an interface association descriptor (or several
+     * interfaces and no class) behind usbccgp, which adds "&mi_xx" to the path. */
+    composite = !memcmp(modalias + 21, "ef", 2) && !memcmp(modalias + 26, "02", 2) && !memcmp(modalias + 30, "01", 2);
+
+    /* the instance id is an opaque hash on Windows; derive a stable one that differs per camera */
+    for (i = 0; vid[i]; i++) hash = (hash ^ (UINT8)vid[i]) * 16777619u;
+    for (i = 0; pid[i]; i++) hash = (hash ^ (UINT8)pid[i]) * 16777619u;
+    hash = (hash ^ index) * 16777619u;
+
+    if (composite)
+        swprintf(device_path, len, L"\\\\?\\usb#vid_%hs&pid_%hs&mi_%hs#6&%08x&0&%04x#{65e8773d-8f56-11d0-a3b9-00a0c9223196}\\global",
+                vid, pid, iface, hash, (unsigned int)strtoul(iface, NULL, 16));
+    else
+        swprintf(device_path, len, L"\\\\?\\usb#vid_%hs&pid_%hs#6&%08x&0&0000#{65e8773d-8f56-11d0-a3b9-00a0c9223196}\\global",
+                vid, pid, hash);
+
+    TRACE("video%u -> %s\n", index, debugstr_w(device_path));
+    return TRUE;
+}
