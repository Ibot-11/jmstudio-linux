+/* "@device:pnp:<DevicePath>" names a video capture device by its DevicePath. */
+static HRESULT parse_pnp_display_name(const WCHAR *path, IMoniker **ret)
+{
+    IEnumMoniker *enum_moniker;
+    IMoniker *moniker;
+    HRESULT hr = MK_E_NOOBJECT;
+
+    if (ICreateDevEnum_CreateClassEnumerator(&devenum_factory, &CLSID_VideoInputDeviceCategory,
+            &enum_moniker, 0) != S_OK)
+        return hr;
+
+    while (hr != S_OK && IEnumMoniker_Next(enum_moniker, 1, &moniker, NULL) == S_OK)
+    {
+        IPropertyBag *bag;
+        VARIANT var;
+
+        VariantInit(&var);
+        if (SUCCEEDED(IMoniker_BindToStorage(moniker, NULL, NULL, &IID_IPropertyBag, (void **)&bag)))
+        {
+            if (SUCCEEDED(IPropertyBag_Read(bag, L"DevicePath", &var, NULL)) && V_VT(&var) == VT_BSTR
+                    && !_wcsicmp(V_BSTR(&var), path))
+            {
+                *ret = moniker;
+                IMoniker_AddRef(moniker);
+                hr = S_OK;
+            }
+            VariantClear(&var);
+            IPropertyBag_Release(bag);
+        }
+        IMoniker_Release(moniker);
+    }
+
+    IEnumMoniker_Release(enum_moniker);
+    return hr;
+}
