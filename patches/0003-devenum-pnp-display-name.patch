+/* USB cameras are named after their DevicePath, as on Windows ("@device:pnp:\\?\usb#vid_...");
+ * applications read the vendor and product ID from the display name. */
+static BSTR get_video_device_path(struct moniker *moniker)
+{
+    VARIANT var;
+
+    if (moniker->type != DEVICE_CODEC || !moniker->has_class
+            || !IsEqualGUID(&moniker->class, &CLSID_VideoInputDeviceCategory))
+        return NULL;
+
+    VariantInit(&var);
+    if (SUCCEEDED(IPropertyBag_Read(&moniker->IPropertyBag_iface, L"DevicePath", &var, NULL))
+            && V_VT(&var) == VT_BSTR && !wcsncmp(V_BSTR(&var), L"\\\\?\\", 4))
+        return V_BSTR(&var);
+
+    VariantClear(&var);
+    return NULL;
+}
