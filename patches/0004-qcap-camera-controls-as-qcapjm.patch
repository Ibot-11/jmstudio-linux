+/* IAMCameraControl. Exposure is the one that matters most: DirectShow expresses it as log2 of
+ * the time in seconds, V4L2 as a count of 100 microsecond units, so convert like Windows' USB
+ * video driver does. Pan and tilt are in degrees here and in arc seconds in V4L2. */
+static LONG exposure_log2_floor(LONG units, BOOL *exact)
+{
+    LONGLONG u = units < 1 ? 1 : units;
+    LONG n;
+
+    if (u >= 10000)
+    {
+        for (n = 0; u >= (10000LL << (n + 1)); ++n) ;
+        *exact = u == (10000LL << n);
+    }
+    else
+    {
+        for (n = -1; (u << -n) < 10000; --n) ;
+        *exact = (u << -n) == 10000;
+    }
+    return n;
+}
+
+/* nearest power of two on a log scale, so that Set followed by Get gives the value back */
+static LONG exposure_log2_round(LONG units)
+{
+    LONGLONG u = units < 1 ? 1 : units;
+    BOOL exact;
+    LONG n = exposure_log2_floor(units, &exact);
+
+    if (n >= 0) return u * u >= 2 * (10000LL << n) * (10000LL << n) ? n + 1 : n;
+    return (u << -n) * (u << -n) >= 2 * 10000LL * 10000LL ? n + 1 : n;
+}
+
+static LONG exposure_units_from_log2(LONG value)
+{
+    if (value < -30) return 0;
+    if (value < 0) return (10000 + (1 << (-value - 1))) >> -value;
+    if (value > 17) return 0x7fffffff;
+    return 10000 << value;
+}
