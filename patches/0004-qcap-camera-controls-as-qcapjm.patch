+static HRESULT WINAPI AMCameraControl_GetRange(IAMCameraControl *iface, LONG property,
+        LONG *min, LONG *max, LONG *step, LONG *default_value, LONG *flags)
+{
+    struct vfw_capture *filter = impl_from_IAMCameraControl(iface);
+    struct get_prop_range_params params = { filter->device, QCAP_CAMERA_CONTROL_BASE + property,
+            min, max, step, default_value, flags };
+    BOOL exact;
+    HRESULT hr;
+
+    TRACE("filter %p, property %ld, min %p, max %p, step %p, default_value %p, flags %p.\n",
+            filter, property, min, max, step, default_value, flags);
+
+    if (!min || !max || !step || !default_value || !flags)
+        return E_POINTER;
+    if (property < 0 || property > QCAP_CAMERA_CONTROL_FOCUS)
+        return E_PROP_ID_UNSUPPORTED;
+    if (FAILED(hr = V4L_CALL( get_prop_range, &params )))
+        return hr;
+
+    if (property == QCAP_CAMERA_CONTROL_EXPOSURE)
+    {
+        /* the smallest and largest value must stay inside what the device accepts */
+        *min = exposure_log2_floor(*min, &exact) + (exact ? 0 : 1);
+        *max = exposure_log2_floor(*max, &exact);
+        *default_value = exposure_log2_floor(*default_value, &exact);
+        *step = 1;
+    }
+    else if (property == QCAP_CAMERA_CONTROL_PAN || property == QCAP_CAMERA_CONTROL_TILT)
+    {
+        *min = (*min + 3599) / 3600;
+        *max /= 3600;
+        *default_value /= 3600;
+        *step = max(1, *step / 3600);
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI AMCameraControl_Set(IAMCameraControl *iface, LONG property, LONG value, LONG flags)
+{
+    struct vfw_capture *filter = impl_from_IAMCameraControl(iface);
+    struct set_prop_params params = { filter->device, QCAP_CAMERA_CONTROL_BASE + property, value, flags };
+
+    TRACE("filter %p, property %ld, value %ld, flags %#lx.\n", filter, property, value, flags);
+
+    if (property < 0 || property > QCAP_CAMERA_CONTROL_FOCUS)
+        return E_PROP_ID_UNSUPPORTED;
+    if (property == QCAP_CAMERA_CONTROL_EXPOSURE)
+        params.value = exposure_units_from_log2(value);
+    else if (property == QCAP_CAMERA_CONTROL_PAN || property == QCAP_CAMERA_CONTROL_TILT)
+        params.value = value * 3600;
+
+    return V4L_CALL( set_prop, &params );
+}
+
+static HRESULT WINAPI AMCameraControl_Get(IAMCameraControl *iface, LONG property, LONG *value, LONG *flags)
+{
+    struct vfw_capture *filter = impl_from_IAMCameraControl(iface);
+    struct get_prop_params params = { filter->device, QCAP_CAMERA_CONTROL_BASE + property, value, flags };
+    HRESULT hr;
+
+    TRACE("filter %p, property %ld, value %p, flags %p.\n", filter, property, value, flags);
+
+    if (!value || !flags)
+        return E_POINTER;
+    if (property < 0 || property > QCAP_CAMERA_CONTROL_FOCUS)
+        return E_PROP_ID_UNSUPPORTED;
+    if (FAILED(hr = V4L_CALL( get_prop, &params )))
+        return hr;
+
+    if (property == QCAP_CAMERA_CONTROL_EXPOSURE)
+        *value = exposure_log2_round(*value);
+    else if (property == QCAP_CAMERA_CONTROL_PAN || property == QCAP_CAMERA_CONTROL_TILT)
+        *value /= 3600;
+    return S_OK;
+}
