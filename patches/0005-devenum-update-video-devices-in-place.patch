+/* Every enumeration used to wipe the device list in the registry and rebuild it, so a thread
+ * listing the cameras while another one did the same (or while the list was being walked by a
+ * caller that parses a moniker's display name) could see no camera at all. Video capture
+ * devices are now updated in place: existing keys stay, only values are rewritten and keys of
+ * devices that are gone are removed. */
+static SRWLOCK video_devices_lock = SRWLOCK_INIT;
+
+static void remove_video_device(int index)
+{
+    WCHAR guidstr[CHARS_IN_GUID], path[MAX_PATH];
+
+    StringFromGUID2(&CLSID_VideoInputDeviceCategory, guidstr, ARRAY_SIZE(guidstr));
+    swprintf(path, ARRAY_SIZE(path), L"Software\\Microsoft\\ActiveMovie\\devenum\\%ls\\video%d", guidstr, index);
+    RegDeleteTreeW(HKEY_CURRENT_USER, path);
+}
+
