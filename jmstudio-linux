#!/usr/bin/env bash
# jmstudio-linux - run 3DMakerpro JMStudio (Moose, Fox, ...) on Linux via Proton or Wine.
#
# JMStudio is proprietary and needs a JMMeta account to download, so this script
# never fetches it: `install` waits for the installer you download yourself.
set -euo pipefail

VERSION="0.2.0"
DOWNLOAD_PAGE="https://forum.jimumeta.com/home/help/download.html"

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CONF_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
JM_HOME="${JMSTUDIO_HOME:-$DATA_HOME/jmstudio-linux}"
PREFIX_DIR="$JM_HOME/prefix"        # Proton's STEAM_COMPAT_DATA_PATH; the Wine prefix is $PREFIX_DIR/pfx
WINE_PREFIX_DIR="$JM_HOME/wineprefix" # plain-Wine runner only
LOG_DIR="$JM_HOME/logs"
STATE_FILE="$JM_HOME/state.env"
USER_ENV="$CONF_HOME/jmstudio-linux/env"
CAMERAFIX_DIR="$JM_HOME/camerafix"  # patched Wine DLLs built by patches/build.sh

PROTON_NAME="${JMSTUDIO_PROTON:-Proton - Experimental}"
RUNNER="${JMSTUDIO_RUNNER:-auto}"   # auto | slr | proton | wine
DEBUG=0
ASSUME_YES=0 GUIDED=0               # set by `install`

SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT")"

# USB IDs of the scanner's stereo cameras (see udev/70-3dmakerpro.rules);
# "bcdc:" matches every product of that vendor ID.
KNOWN_IDS=(bcdc: 0c45:636a 0c45:636b)

# Filled in by resolve_runner
PROTON_DIR="" SLR_ENTRY="" STEAM_ROOT="" EXE=""

msg()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
	cat <<EOF
jmstudio-linux $VERSION - run 3DMakerpro JMStudio on Linux

Usage: jmstudio-linux [options] <command> [args]

Commands:
  install [--yes]         do everything: check requirements, install JMStudio, USB rules,
                          camera fix, menu entry (--installer FILE: use this JMStudio installer)
  setup [INSTALLER.exe]   only create the prefix and run the JMStudio installer
                          (--silent: unattended, --exe PATH: skip auto-detection)
  run [args]              start JMStudio (default command)
  doctor                  check Proton, USB access, GPU and the scanner
  udev                    install the udev rules for the scanner (asks for your password)
  camerafix [ACTION]      patched Wine DLLs so JMStudio can find the scanner, ACTION =
                          build | install (default) | remove | status
  desktop                 (re)create the application menu entry
  set-exe PATH            tell the launcher where JMStudio.exe is
  winecfg | regedit | cmd | reg   run the Wine tool inside the prefix
  winetricks VERB...      run winetricks against the prefix (e.g. vcrun2022)
  logs                    print the path of the newest Proton log
  uninstall               remove the menu entry, launcher link, and (after asking) USB rules and prefix

Options:
  --debug                 write a Proton log to $LOG_DIR and enable USB/camera tracing
  --proton NAME|DIR       Proton to use (default: "$PROTON_NAME"), e.g. GE-Proton11-7-x86_64
  --runner R              auto | slr | proton | wine (default: auto)
  -h, --help              this text

Environment: JMSTUDIO_HOME, JMSTUDIO_PROTON, JMSTUDIO_RUNNER.
Extra environment variables for JMStudio go in $USER_ENV (one 'export FOO=bar' per line).
EOF
}

# ---------------------------------------------------------------- discovery

steam_roots() {
	local r seen=""
	for r in "$DATA_HOME/Steam" "$HOME/.steam/steam" "$HOME/.steam/root" \
	         "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"; do
		[[ -d $r/steamapps ]] || continue
		r="$(readlink -f "$r")"
		[[ $seen == *"|$r|"* ]] && continue
		seen+="|$r|"
		echo "$r"
	done
}

# Every Steam library folder, including the roots themselves.
steam_libraries() {
	local root vdf
	while IFS= read -r root; do
		echo "$root"
		vdf="$root/steamapps/libraryfolders.vdf"
		[[ -f $vdf ]] && sed -n 's/^[[:space:]]*"path"[[:space:]]*"\(.*\)"/\1/p' "$vdf"
	done < <(steam_roots) | awk '!seen[$0]++'
}

find_proton() {
	local name="$PROTON_NAME" lib root d
	if [[ -x $name/proton ]]; then readlink -f "$name"; return 0; fi
	while IFS= read -r lib; do
		d="$lib/steamapps/common/$name"
		[[ -x $d/proton ]] && { readlink -f "$d"; return 0; }
	done < <(steam_libraries)
	while IFS= read -r root; do
		d="$root/compatibilitytools.d/$name"
		[[ -x $d/proton ]] && { readlink -f "$d"; return 0; }
	done < <(steam_roots)
	d="/usr/share/steam/compatibility-tools.d/$name"
	[[ -x $d/proton ]] && { readlink -f "$d"; return 0; }
	return 1
}

# The container runtime a Proton build asks for (toolmanifest require_tool_appid).
find_slr_entry() {
	local proton="$1" appid lib acf dir
	appid="$(sed -n 's/.*"require_tool_appid"[[:space:]]*"\([0-9]*\)".*/\1/p' "$proton/toolmanifest.vdf" 2>/dev/null | head -1)"
	[[ -n $appid ]] || return 1
	while IFS= read -r lib; do
		acf="$lib/steamapps/appmanifest_$appid.acf"
		[[ -f $acf ]] || continue
		dir="$(sed -n 's/.*"installdir"[[:space:]]*"\(.*\)".*/\1/p' "$acf" | head -1)"
		[[ -x $lib/steamapps/common/$dir/_v2-entry-point ]] && { echo "$lib/steamapps/common/$dir/_v2-entry-point"; return 0; }
	done < <(steam_libraries)
	return 1
}

resolve_runner() {
	if [[ $RUNNER == wine ]]; then
		command -v wine >/dev/null || die "runner 'wine' selected but wine is not installed"
		return
	fi
	PROTON_DIR="$(find_proton)" || {
		[[ $RUNNER == auto ]] && command -v wine >/dev/null && {
			warn "'$PROTON_NAME' not found, falling back to system Wine"; RUNNER=wine; return; }
		die "'$PROTON_NAME' not found. Install it in Steam (Library > Tools > Proton Experimental) or pass --proton."
	}
	STEAM_ROOT="$(steam_roots | head -1)"
	[[ -n $STEAM_ROOT ]] || die "no Steam installation found (Proton needs STEAM_COMPAT_CLIENT_INSTALL_PATH)"
	if [[ $RUNNER == auto || $RUNNER == slr ]]; then
		if SLR_ENTRY="$(find_slr_entry "$PROTON_DIR")"; then RUNNER=slr
		elif [[ $RUNNER == slr ]]; then die "Steam Linux Runtime for $PROTON_NAME not installed (start Steam once with that Proton)"
		else warn "Steam Linux Runtime not found, running Proton without its container"; RUNNER=proton
		fi
	fi
}

proton_wine_bin() {
	local p
	for p in files/bin/wine64 files/bin/wine dist/bin/wine64 dist/bin/wine; do
		[[ -x $PROTON_DIR/$p ]] && { echo "$PROTON_DIR/$p"; return 0; }
	done
	return 1
}

wine_prefix() { [[ $RUNNER == wine ]] && echo "$WINE_PREFIX_DIR" || echo "$PREFIX_DIR/pfx"; }

# ---------------------------------------------------------------- execution

# Run a Windows command inside the prefix with the selected runner.
run_in_prefix() {
	mkdir -p "$PREFIX_DIR" "$LOG_DIR"
	# shellcheck disable=SC1090
	[[ -f $USER_ENV ]] && source "$USER_ENV"
	# The camera fix's renamed qcap (qcapjm.dll + qcapjm.so) lives outside Proton; Proton appends
	# this WINEDLLPATH to its own so the loader finds it.
	if [[ -d $CAMERAFIX_DIR/overlay/x86_64-unix ]]; then
		export WINEDLLPATH="$CAMERAFIX_DIR/overlay${WINEDLLPATH:+:$WINEDLLPATH}"
	fi
	# Proton only writes a log when SteamGameId is set; the id itself is arbitrary here
	export SteamGameId="${SteamGameId:-jmstudio}"
	if (( DEBUG )); then
		export PROTON_LOG=1 PROTON_LOG_DIR="$LOG_DIR"
		export WINEDEBUG="${WINEDEBUG:-+timestamp,+usb,+qcap,+dshow,+mfplat,err+all}"
		msg "debug log: $LOG_DIR/steam-$SteamGameId.log - WINEDEBUG=$WINEDEBUG"
	fi
	case $RUNNER in
		slr)
			# the container only sees $HOME and the prefix by default; JM_HOME may live elsewhere
			PRESSURE_VESSEL_FILESYSTEMS_RW="$JM_HOME${PRESSURE_VESSEL_FILESYSTEMS_RW:+:$PRESSURE_VESSEL_FILESYSTEMS_RW}" \
			STEAM_COMPAT_DATA_PATH="$PREFIX_DIR" STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_ROOT" \
				"$SLR_ENTRY" --verb=waitforexitandrun -- "$PROTON_DIR/proton" waitforexitandrun "$@" ;;
		proton)
			STEAM_COMPAT_DATA_PATH="$PREFIX_DIR" STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_ROOT" \
				"$PROTON_DIR/proton" waitforexitandrun "$@" ;;
		wine)
			mkdir -p "$WINE_PREFIX_DIR"
			WINEPREFIX="$WINE_PREFIX_DIR" WINEDEBUG="${WINEDEBUG:--all}" wine "$@" ;;
	esac
}

load_state() {
	# shellcheck disable=SC1090
	[[ -f $STATE_FILE ]] && source "$STATE_FILE"
	EXE="${JMSTUDIO_EXE:-}"
}

save_exe() {
	mkdir -p "$JM_HOME"
	printf 'JMSTUDIO_EXE=%q\n' "$1" > "$STATE_FILE"
	EXE="$1"
}

# JMStudio.exe inside the prefix; skip uninstallers, redistributables and crash helpers.
find_exe() {
	local root="$1" f best=""
	local -a hits=()
	while IFS= read -r -d '' f; do hits+=("$f"); done < <(
		find "$root/drive_c" -type f -iname '*jmstudio*.exe' \
			! -iname 'unins*' ! -iname '*setup*' ! -iname '*crash*' ! -iname '*update*' -print0 2>/dev/null)
	for f in "${hits[@]}"; do
		[[ ${f##*/} == [Jj][Mm][Ss]tudio.exe ]] && best="$f"
	done
	[[ -z $best && ${#hits[@]} -eq 1 ]] && best="${hits[0]}"
	if [[ -n $best ]]; then echo "$best"; return 0; fi
	(( ${#hits[@]} )) && printf '  candidate: %s\n' "${hits[@]}" >&2
	return 1
}

# ---------------------------------------------------------------- commands

cmd_setup() {
	local installer="" silent=0 exe_arg=""
	while (( $# )); do
		case $1 in
			--silent) silent=1 ;;
			--exe) exe_arg="${2:?--exe needs a path}"; shift ;;
			*) installer="$1" ;;
		esac
		shift
	done
	resolve_runner

	if [[ -z $installer ]]; then
		installer="$(find "$HOME/Downloads" "$HOME/Desktop" "$PWD" -maxdepth 2 -type f \
			-iname 'JMStudioSetup*.exe' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2- || true)"
	fi
	if [[ -z $installer || ! -f $installer ]]; then
		cat >&2 <<EOF
No JMStudio installer found.

Download "JMStudio > Windows" from
  $DOWNLOAD_PAGE
(a free JMMeta account is required), then run:
  jmstudio-linux setup ~/Downloads/JMStudioSetup-*.exe
EOF
		exit 1
	fi

	msg "runner: $RUNNER${PROTON_DIR:+, $(basename "$PROTON_DIR") ($(tr -d '\n' < "$PROTON_DIR/version" 2>/dev/null))}"
	msg "installer: $installer"
	msg "sha256: $(sha256sum "$installer" | cut -d' ' -f1)"

	local -a flags=()
	if (( silent )); then
		if grep -qa 'Inno Setup' "$installer"; then flags=(/VERYSILENT /SUPPRESSMSGBOXES /NORESTART)
		elif grep -qa 'Nullsoft' "$installer"; then flags=(/S)
		else warn "unknown installer type, ignoring --silent"; fi
	fi
	msg "running the installer (this also creates the prefix on first use)..."
	if (( silent )); then
		# The installer starts JMStudio when it is done and Proton waits for it to exit.
		# Close that first start (only an instance that was not running before) so we can go on.
		local before ipid pid
		before=" $(pgrep -x JMStudio.exe | tr '\n' ' ' || true) "
		run_in_prefix "$installer" "${flags[@]}" &
		ipid=$!
		while kill -0 "$ipid" 2>/dev/null; do
			for pid in $(pgrep -x JMStudio.exe || true); do
				[[ $before == *" $pid "* ]] && continue
				before+="$pid "
				sleep 3
				kill -TERM "$pid" 2>/dev/null || true
			done
			sleep 2
		done
		wait "$ipid" || warn "installer exited with an error, checking for an installation anyway"
	else
		run_in_prefix "$installer" "${flags[@]}" || warn "installer exited with an error, checking for an installation anyway"
	fi

	if [[ -n $exe_arg ]]; then
		save_exe "$exe_arg"
	elif EXE="$(find_exe "$(wine_prefix)")"; then
		save_exe "$EXE"
	else
		die "installation finished but JMStudio.exe was not found. Locate it and run: jmstudio-linux set-exe PATH"
	fi
	msg "JMStudio: $EXE"
	cmd_desktop
	(( GUIDED )) && return 0
	cat <<EOF

Done. Next steps:
  1. $SCRIPT udev             # one-time USB permissions for the scanner (asks for your password)
  2. $SCRIPT camerafix        # patched Wine DLLs so JMStudio can find the scanner (builds them)
  3. $SCRIPT doctor
  4. $SCRIPT run
(or let `$SCRIPT install` do all of this for you)
EOF
}

cmd_run() {
	load_state
	[[ -n $EXE && -f $EXE ]] || die "JMStudio is not set up yet. Run: jmstudio-linux setup (see --help)"
	resolve_runner
	cd "$(dirname "$EXE")"
	run_in_prefix "$EXE" "$@"
}

cmd_desktop() {
	load_state
	local dir="$DATA_HOME/applications"
	mkdir -p "$dir"
	cat > "$dir/jmstudio-linux.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=JMStudio (3DMakerpro)
Comment=3D scanner software for the Moose, run through Proton
Exec="$SCRIPT" run
Icon=applications-graphics
Categories=Graphics;3DGraphics;
Terminal=false
StartupNotify=true
EOF
	msg "menu entry: $dir/jmstudio-linux.desktop"
}

cmd_set_exe() {
	local p="${1:?usage: jmstudio-linux set-exe PATH}"
	[[ -f $p ]] || die "no such file: $p"
	save_exe "$(readlink -f "$p")"
	msg "JMStudio: $EXE"
}

# Run a command as root. sudo needs a terminal; without one, polkit shows a graphical
# password dialog instead.
as_root() {
	if (( EUID == 0 )); then "$@"
	elif [[ -t 0 ]] && command -v sudo >/dev/null; then sudo "$@"
	elif command -v pkexec >/dev/null; then pkexec "$@"
	elif command -v sudo >/dev/null; then sudo "$@"
	else die "root is needed: install sudo or polkit (pkexec)"
	fi
}

UDEV_RULES_DEST="/etc/udev/rules.d/70-3dmakerpro.rules"

cmd_udev() {
	local rules="$SCRIPT_DIR/udev/70-3dmakerpro.rules"
	[[ -f $rules ]] || die "rules file missing: $rules"
	msg "installing $UDEV_RULES_DEST"
	as_root sh -c 'install -m 644 "$1" "$2" && udevadm control --reload-rules && udevadm trigger --subsystem-match=usb --action=add' sh "$rules" "$UDEV_RULES_DEST"
	msg "done"
}

# Wine alone cannot show the scanner to JMStudio or let it dim the LEDs (see patches/): DirectShow
# reports no USB vendor/product ID for cameras (devenum.dll), Media Foundation lists no cameras
# (mf.dll), and the camera filter has no exposure control (qcap). The camera fix puts patched
# builds into this prefix: devenum.dll and mf.dll replace the prefix's copies (symlinks into
# Proton), and qcapjm (a renamed qcap) is added next to them and registered for the camera
# filter's class. Proton itself stays untouched.
CAMERAFIX_DLLS=(devenum mf)
QCAP_CLSID='{1B544C22-FD0B-11CE-8C63-00AA0044B51E}'   # "VFW Capture Filter"
QCAP_KEY='HKLM\Software\Classes\CLSID\'"$QCAP_CLSID"'\InprocServer32'

camerafix_target() { echo "$(wine_prefix)/drive_c/windows/system32/$1.dll"; }

# True when every patched DLL is in the prefix (a regular file, original kept beside it).
camerafix_installed() {
	local d t
	for d in "${CAMERAFIX_DLLS[@]}"; do
		t="$(camerafix_target "$d")"
		[[ -f $t && ! -L $t && ( -e $t.orig || -L $t.orig ) ]] || return 1
	done
	[[ -f $CAMERAFIX_DIR/overlay/x86_64-unix/qcapjm.so && -f "$(camerafix_target qcapjm)" ]]
}

# The patches change between versions; build.sh records which ones a build was made from.
camerafix_patch_hash() { cat "$SCRIPT_DIR"/patches/0*.patch "$SCRIPT_DIR/patches/build.sh" | sha256sum | cut -d' ' -f1; }

# True when the build in the prefix was made from the patches in this checkout.
camerafix_current() {
	[[ -f $CAMERAFIX_DIR/.installed-patches && "$(<"$CAMERAFIX_DIR/.installed-patches")" == "$(camerafix_patch_hash)" ]]
}

camerafix_install() {
	local d t build=0
	for d in "${CAMERAFIX_DLLS[@]}"; do
		[[ -f $CAMERAFIX_DIR/$d.dll ]] || build=1
	done
	[[ -f $CAMERAFIX_DIR/overlay/x86_64-unix/qcapjm.so && -f $CAMERAFIX_DIR/.built-patches \
		&& "$(<"$CAMERAFIX_DIR/.built-patches")" == "$(camerafix_patch_hash)" ]] || build=1
	if (( build )); then
		msg "building the patched DLLs"
		"$SCRIPT_DIR/patches/build.sh" "$CAMERAFIX_DIR"
	fi
	for d in "${CAMERAFIX_DLLS[@]}"; do
		t="$(camerafix_target "$d")"
		[[ -e $t || -L $t ]] || die "no prefix yet - run: jmstudio-linux setup"
		[[ -e $t.orig || -L $t.orig ]] || mv "$t" "$t.orig"
		cp --remove-destination "$CAMERAFIX_DIR/$d.dll" "$t"
		# Wine swaps files that carry its "builtin" marker for its own copy; blank the marker
		# so the prefix file is treated as a native DLL and loaded instead.
		head -c 16 /dev/zero | dd of="$t" bs=1 seek=64 conv=notrunc status=none
		run_in_prefix reg add 'HKCU\Software\Wine\DllOverrides' /v "$d" /d 'native,builtin' /f
	done
	# qcapjm: a renamed qcap. Its Linux half is found through WINEDLLPATH (see run_in_prefix);
	# the camera filter's class is pointed at it.
	t="$(camerafix_target qcapjm)"
	cp --remove-destination "$CAMERAFIX_DIR/overlay/x86_64-windows/qcapjm.dll" "$t"
	run_in_prefix reg add "$QCAP_KEY" /ve /d 'C:\windows\system32\qcapjm.dll' /f
	cp "$CAMERAFIX_DIR/.built-patches" "$CAMERAFIX_DIR/.installed-patches"
	msg "camera fix installed - restart JMStudio"
}

camerafix_remove() {
	local d t
	for d in "${CAMERAFIX_DLLS[@]}"; do
		t="$(camerafix_target "$d")"
		run_in_prefix reg delete 'HKCU\Software\Wine\DllOverrides' /v "$d" /f || true
		if [[ -e $t.orig || -L $t.orig ]]; then
			rm -f "$t"
			mv "$t.orig" "$t"
		fi
	done
	run_in_prefix reg add "$QCAP_KEY" /ve /d 'C:\windows\system32\qcap.dll' /f || true
	rm -f "$(camerafix_target qcapjm)"
	msg "original Wine DLLs restored"
}

cmd_camerafix() {
	local action="${1:-install}"
	case $action in
		build)   "$SCRIPT_DIR/patches/build.sh" "$CAMERAFIX_DIR" ;;
		install) resolve_runner; camerafix_install ;;
		remove)  resolve_runner; camerafix_remove ;;
		status)  resolve_runner; camerafix_installed && echo "installed" || { echo "not installed"; return 1; } ;;
		*)       die "usage: jmstudio-linux camerafix [build|install|remove|status]" ;;
	esac
}

cmd_tool() {
	resolve_runner
	run_in_prefix "$@"
}

cmd_winetricks() {
	command -v winetricks >/dev/null || die "winetricks is not installed"
	resolve_runner
	if [[ $RUNNER == wine ]]; then
		WINEPREFIX="$WINE_PREFIX_DIR" winetricks "$@"
	else
		local wine; wine="$(proton_wine_bin)" || die "no wine binary in $PROTON_DIR"
		WINEPREFIX="$PREFIX_DIR/pfx" WINE="$wine" WINESERVER="$(dirname "$wine")/wineserver" winetricks "$@"
	fi
}

cmd_logs() {
	local f; f="$(ls -t "$LOG_DIR"/*.log 2>/dev/null | head -1)"
	[[ -n $f ]] && echo "$f" || die "no logs yet - start with: jmstudio-linux --debug run"
}

cmd_uninstall() {
	rm -f "$DATA_HOME/applications/jmstudio-linux.desktop"
	msg "menu entry removed"
	local link="${JMSTUDIO_BIN_DIR:-$HOME/.local/bin}/jmstudio-linux"
	if [[ -L $link && "$(readlink -f "$link")" == "$SCRIPT" ]]; then rm -f "$link"; msg "removed $link"; fi
	if [[ -f $UDEV_RULES_DEST ]] && ask "Remove the USB rules $UDEV_RULES_DEST (asks for your password)?" n; then
		as_root sh -c 'rm -f "$1" && udevadm control --reload-rules' sh "$UDEV_RULES_DEST" && msg "USB rules removed"
	fi
	if [[ -d $JM_HOME && $JM_HOME != / && $JM_HOME != "$HOME" ]] && \
	   ask "Delete $JM_HOME (the Proton prefix, logs, the installed JMStudio, the patched DLLs)?" n; then
		rm -rf -- "$JM_HOME" && msg "deleted $JM_HOME"
	fi
	local cache="${XDG_CACHE_HOME:-$HOME/.cache}/jmstudio-linux"
	if [[ -d $cache ]] && ask "Delete the build cache $cache (the Wine sources, about 600 MB)?" n; then
		rm -rf -- "$cache" && msg "deleted $cache"
	fi
	return 0
}

cmd_doctor() {
	local ok=0 bad=0
	pass() { printf '  \033[32mok\033[0m    %s\n' "$*"; ok=$((ok+1)); }
	fail() { printf '  \033[31mFAIL\033[0m  %s\n' "$*"; bad=$((bad+1)); }
	note() { printf '  \033[33m..\033[0m    %s\n' "$*"; }

	echo "Runner"
	if (resolve_runner) 2>/dev/null; then
		resolve_runner
		pass "runner: $RUNNER${PROTON_DIR:+ / $PROTON_DIR}"
		[[ -n $PROTON_DIR ]] && note "version: $(tr -d '\n' < "$PROTON_DIR/version" 2>/dev/null)"
		[[ -n $SLR_ENTRY ]] && pass "container runtime: $SLR_ENTRY"
	else
		fail "no usable Proton/Wine found (see --help)"
	fi
	[[ -e /dev/ntsync ]] && pass "/dev/ntsync present (fast sync)" || note "no /dev/ntsync (kernel < 6.14 or module not loaded) - works, just slower"

	echo "JMStudio"
	load_state
	if [[ -n $EXE && -f $EXE ]]; then pass "installed: $EXE"; else fail "not set up - run: jmstudio-linux setup"; fi
	if camerafix_installed; then
		if camerafix_current; then pass "camera fix (patched devenum.dll, mf.dll and qcapjm) installed"
		else fail "camera fix is older than the patches in this checkout (newer ones fix hangs when the scanner is stopped). Run: $SCRIPT camerafix"; fi
	else fail "camera fix missing - JMStudio cannot find the scanner. Run: $SCRIPT camerafix"; fi

	echo "Scanner (USB)"
	local id found=0 line bus dev node name
	for id in "${KNOWN_IDS[@]}"; do
		while IFS= read -r line; do
			[[ -n $line ]] || continue
			found=1
			bus="$(awk '{print $2}' <<<"$line")"; dev="$(awk '{print $4}' <<<"$line")"; dev="${dev%:}"
			node="/dev/bus/usb/$bus/$dev"
			name="${line#*ID }"
			if [[ -r $node && -w $node ]]; then pass "$name is accessible ($node)"
			else fail "$name found but $node is not writable - run: $SCRIPT udev, then replug"; fi
		done < <(lsusb -d "$id" 2>/dev/null || true)
	done
	if (( ! found )); then
		fail "scanner not found (looked for ${KNOWN_IDS[*]}). Plugged in? Try another USB 2.0 port without a hub."
		note "other cameras: $(lsusb | grep -iE 'kyt|jimu|3dmaker|0c45' | tr '\n' ';' || true)"
	fi
	[[ -f /etc/udev/rules.d/70-3dmakerpro.rules ]] && pass "udev rules installed" || note "udev rules not installed ($SCRIPT udev)"
	if compgen -G '/sys/class/video4linux/video*' >/dev/null; then
		local v; for v in /sys/class/video4linux/video*; do note "${v##*/}: $(cat "$v/name" 2>/dev/null)"; done
	fi
	id -nG | tr ' ' '\n' | grep -qx video && pass "user is in group 'video'" || note "user not in group 'video' (cameras may need it)"

	echo "Graphics"
	if command -v vulkaninfo >/dev/null; then
		vulkaninfo --summary 2>/dev/null | sed -n 's/^[[:space:]]*deviceName[[:space:]]*=[[:space:]]*/  ok    GPU: /p' | sort -u
	else
		note "vulkaninfo not installed - cannot list GPUs"
	fi
	echo; echo "$ok ok, $bad problem(s)"
	(( bad == 0 ))
}

# ---------------------------------------------------------------- guided install

PROTON_APPID=1493710                # Steam app id of "Proton Experimental"
BUILD_TOOLS=(clang lld-link flex bison gcc make patch curl tar xz)

have_tty() { { : < /dev/tty; } 2>/dev/null; }

# Yes/no question. Reads from the terminal even when this script came through a pipe
# (curl ... | bash). --yes answers yes to everything; without a terminal the default wins.
ask() {
	local question="$1" default="${2:-y}" hint="[Y/n]" answer
	[[ $default == n ]] && hint="[y/N]"
	(( ASSUME_YES )) && return 0
	have_tty || { [[ $default == y ]]; return; }
	read -r -p "$question $hint " answer < /dev/tty || return 1
	answer="${answer:-$default}"
	[[ $answer == [yY]* ]]
}

step() { printf '\n\033[1m[%s/6] %s\033[0m\n' "$1" "$2"; }
ok()   { printf '  \033[32mok\033[0m  %s\n' "$*"; }

missing_tools() { local c; for c in "$@"; do command -v "$c" >/dev/null || printf '%s ' "$c"; done; }

# The command that installs the camera fix's build tools on the common distributions.
package_install_command() {
	local id="" like=""
	if [[ -r /etc/os-release ]]; then
		id="$(. /etc/os-release; echo "${ID:-}")"
		like="$(. /etc/os-release; echo "${ID_LIKE:-}")"
	fi
	case " $id $like " in
		*" arch "*|*" cachyos "*|*" manjaro "*|*" endeavouros "*)
			echo "sudo pacman -S --needed clang lld flex bison gcc make patch curl tar xz usbutils linux-api-headers" ;;
		*" debian "*|*" ubuntu "*)
			echo "sudo apt install clang lld flex bison gcc make patch curl tar xz-utils usbutils linux-libc-dev" ;;
		*" fedora "*|*" rhel "*)
			echo "sudo dnf install clang lld flex bison gcc make patch curl tar xz usbutils kernel-headers" ;;
		*" suse "*|*" opensuse-tumbleweed "*|*" opensuse-leap "*)
			echo "sudo zypper install clang lld flex bison gcc make patch curl tar xz usbutils linux-glibc-devel" ;;
	esac
}

jmstudio_running() { pgrep -x JMStudio.exe >/dev/null; }

# Step 1: Steam, Proton Experimental and the tools the camera fix is built with.
install_requirements() {
	local missing cmd n

	[[ -n "$(steam_roots)" ]] || die "Steam was not found. Install Steam (your package manager or https://store.steampowered.com), start it once and log in, then run this installer again."
	ok "Steam: $(steam_roots | head -1)"

	if ! find_proton >/dev/null; then
		warn "'$PROTON_NAME' is not installed in Steam yet."
		[[ $PROTON_NAME == "Proton - Experimental" ]] || die "install '$PROTON_NAME' (or pick another with --proton) and run this installer again."
		ask "Open Steam's install dialog for Proton Experimental now?" y \
			|| die "install it in Steam (Library, show Tools, Proton Experimental) and run this installer again."
		(steam "steam://install/$PROTON_APPID" || xdg-open "steam://install/$PROTON_APPID") >/dev/null 2>&1 &
		msg "confirm the installation in Steam; waiting for it (Ctrl+C to cancel)..."
		for ((n = 0; n < 400; n++)); do find_proton >/dev/null && break; sleep 3; done
		find_proton >/dev/null || die "Proton Experimental did not show up in Steam within 20 minutes."
	fi
	PROTON_DIR="$(find_proton)"
	ok "Proton: $(basename "$PROTON_DIR") ($(tr -d '\n' < "$PROTON_DIR/version" 2>/dev/null))"

	# Steam installs the container runtime together with Proton; it may still be downloading.
	for ((n = 0; n < 200; n++)); do find_slr_entry "$PROTON_DIR" >/dev/null && break; (( n == 0 )) && msg "waiting for Steam to finish downloading the Steam Linux Runtime..."; sleep 3; done
	find_slr_entry "$PROTON_DIR" >/dev/null || warn "Steam Linux Runtime not found; Proton will run without its container"

	missing="$(missing_tools "${BUILD_TOOLS[@]}")"
	[[ -f /usr/include/linux/videodev2.h ]] || missing+="linux-headers "
	if [[ -n $missing ]]; then
		warn "missing tools for the camera fix: $missing"
		cmd="$(package_install_command)"
		if [[ -n $cmd ]] && ask "Install them now with '$cmd'?" y; then
			bash -c "$cmd" || die "installing the build tools failed"
		else
			die "install ${BUILD_TOOLS[*]} (${cmd:+for example: $cmd}) and run this installer again."
		fi
		missing="$(missing_tools "${BUILD_TOOLS[@]}")"
		[[ -f /usr/include/linux/videodev2.h ]] || missing+="linux-headers "
		[[ -z $missing ]] || die "still missing: $missing"
	fi
	ok "build tools for the camera fix"
	command -v lsusb >/dev/null || warn "lsusb (usbutils) is not installed; 'doctor' cannot list the scanner"
}

find_installer() {
	find "$HOME/Downloads" "$HOME/Desktop" "$PWD" -maxdepth 2 -type f -iname 'JMStudioSetup*.exe' \
		-printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2- || true
}

# Step 2: JMStudio needs a (free) JMMeta login to download, so the user has to fetch it.
install_get_installer() {
	local f="${1:-}" size1 size2
	if [[ -z $f ]]; then f="$(find_installer)"; fi
	if [[ -n $f && -f $f ]]; then
		ok "JMStudio installer: $f"
		INSTALLER="$f"
		return
	fi
	cat <<EOF
  JMStudio is proprietary and can only be downloaded with a free JMMeta account, so this
  installer cannot fetch it for you:
    1. open $DOWNLOAD_PAGE
    2. under "JMStudio" > "Windows" click Download (log in or sign up when asked)
    3. save the file (JMStudioSetup-....exe) to ~/Downloads
EOF
	have_tty || die "no JMStudio installer found; download it as described above and run this installer again."
	if command -v xdg-open >/dev/null && ask "Open that page in your browser now?" y; then
		xdg-open "$DOWNLOAD_PAGE" >/dev/null 2>&1 || true
	fi
	msg "waiting for JMStudioSetup-*.exe in ~/Downloads (Ctrl+C to cancel)..."
	until f="$(find_installer)"; [[ -n $f ]]; do sleep 3; done
	# wait until the browser has finished writing it
	size1=-1
	while size2="$(stat -c %s "$f" 2>/dev/null || echo 0)"; [[ $size2 != "$size1" ]]; do size1=$size2; sleep 3; done
	ok "JMStudio installer: $f"
	INSTALLER="$f"
}

# Step 4: the scanner's cameras need USB write access for Wine.
install_udev() {
	local rules="$SCRIPT_DIR/udev/70-3dmakerpro.rules"
	if cmp -s "$rules" "$UDEV_RULES_DEST" 2>/dev/null; then ok "USB rules already installed"; return; fi
	echo "  The scanner's cameras need USB write access for Wine. This installs $UDEV_RULES_DEST"
	echo "  and asks for your password."
	if ask "Install the USB rules?" y; then cmd_udev
	else warn "skipped - JMStudio will not find the scanner without them (later: jmstudio-linux udev)"; fi
}

# Put `jmstudio-linux` on the PATH (the menu entry points at the script itself).
install_link() {
	local bin="${JMSTUDIO_BIN_DIR:-$HOME/.local/bin}" link
	link="$bin/jmstudio-linux"
	mkdir -p "$bin"
	if [[ ! -e $link || -L $link ]]; then ln -sf "$SCRIPT" "$link"; fi
	case ":$PATH:" in *":$bin:"*) ;; *) warn "$bin is not in your PATH; run $SCRIPT or add that folder to PATH" ;; esac
}

cmd_install() {
	local installer=""
	while (( $# )); do
		case $1 in
			-y|--yes) ASSUME_YES=1 ;;
			--installer) installer="${2:?--installer needs a file}"; shift ;;
			*) die "unknown option for install: $1 (see --help)" ;;
		esac
		shift
	done
	GUIDED=1
	cat <<EOF
jmstudio-linux $VERSION installer

This sets up JMStudio (3DMakerpro) for your scanner on Linux:
  - a separate Proton prefix in $JM_HOME (Steam's games are not touched)
  - JMStudio itself, from the installer you download
  - USB permissions for the scanner (one password prompt)
  - a small Wine fix so JMStudio can find the scanner (built from source, ~1 minute)
  - an entry in your application menu
EOF
	ask "Continue?" y || exit 0

	step 1 "Requirements"
	install_requirements
	resolve_runner
	if jmstudio_running; then die "JMStudio is running. Close it and run this installer again."; fi

	step 2 "JMStudio installer"
	load_state
	if [[ -n $EXE && -f $EXE ]] && [[ -z $installer ]]; then
		ok "JMStudio is already installed: $EXE"
		INSTALLER=""
	else
		install_get_installer "$installer"
	fi

	step 3 "Installing JMStudio"
	if [[ -n ${INSTALLER:-} ]]; then
		cmd_setup --silent "$INSTALLER"
	else
		ok "skipped (already installed)"
	fi

	step 4 "USB permissions"
	install_udev

	step 5 "Camera fix"
	if camerafix_installed && camerafix_current; then ok "already installed"; else camerafix_install; fi
	install_link
	cmd_desktop

	step 6 "Check"
	cmd_doctor || true
	cat <<EOF

Done. Plug the scanner in and start "JMStudio (3DMakerpro)" from your application menu
(or run: jmstudio-linux run). The first start needs an internet connection and a login.
Something wrong? Run: jmstudio-linux doctor
EOF
}

# ---------------------------------------------------------------- main

while (( $# )); do
	case $1 in
		--debug) DEBUG=1 ;;
		--proton) PROTON_NAME="${2:?--proton needs a value}"; shift ;;
		--runner) RUNNER="${2:?--runner needs a value}"; shift ;;
		-h|--help) usage; exit 0 ;;
		*) break ;;
	esac
	shift
done

cmd="${1:-run}"; (( $# )) && shift
case $cmd in
	install)       cmd_install "$@" ;;
	setup)         cmd_setup "$@" ;;
	run)           cmd_run "$@" ;;
	doctor)        cmd_doctor ;;
	udev)          cmd_udev ;;
	camerafix)     cmd_camerafix "$@" ;;
	desktop)       cmd_desktop ;;
	set-exe)       cmd_set_exe "$@" ;;
	winecfg|regedit|cmd|reg) cmd_tool "$cmd" "$@" ;;
	winetricks)    cmd_winetricks "$@" ;;
	logs)          cmd_logs ;;
	uninstall)     cmd_uninstall ;;
	help)          usage ;;
	*)             usage >&2; exit 2 ;;
esac
